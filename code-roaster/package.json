{
  "name": "code-roaster",
  "displayName": "Roast My Code",
  "description": "Roasts your code like a comedian but actually helps you improve it",
  "version": "0.0.1",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "activationEvents": [
    "onCommand:code-roaster.roastMyCode",
    "onCommand:code-roaster.roastSelection"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "code-roaster.roastMyCode",
        "title": "Roast My Code"
      },
      {
        "command": "code-roaster.roastSelection",
        "title": "🔥 Roast Selected Code"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "code-roaster.roastSelection",
          "when": "editorHasSelection",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Roast My Code",
      "properties": {
        "codeRoaster.apiKey": {
          "type": "string",
          "default": "",
          "description": "Your OpenAI API Key"
        },
        "codeRoaster.roastLevel": {
          "type": "string",
          "enum": ["mild", "medium", "savage"],
          "default": "medium",
          "description": "How savage should the roast be?"
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node ./test/extension.test.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0"
  },
  "dependencies": {
    "openai": "^4.0.0"
  }
}
